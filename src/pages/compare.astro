  }
  :global(.cmp-th--k) {
    width: 34%;
    min-width: 170px;
  }
  :global(.cmp-th__name) {
    display: block;
    font-size: 13.5px;
  }
  :global(.cmp-th__en) {
    margin-left: 6px;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
    font-weight: 400;
  }
  :global(.cmp-th__when) {
    display: block;
    margin-top: 3px;
    font-size: 11px;
    font-weight: 400;
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }
  :global(.cmp-th__slice) {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    padding: 0 5px;
    font-size: 10px;
  }
  :global(.cmp-th__dead) {
    color: #ffb4b4;
    font-size: 10.5px;
  }
  :global(.cmp-th.is-dead) {
    background: #4a3b3b;
  }

  /* 同步失败提示行：两舰没有共同在世时段时插在表头下面 */
  :global(.cmp-warnrow) {
    background: #fdf6e3;
    color: #7a5c00;
    font-size: 11.5px;
    line-height: 1.6;
    padding: 8px 13px;
    border-bottom: 1px solid #e8d9a8;
  }

  /* 以下是 tbody 内部样式。整个 tbody 都是脚本用 innerHTML 生成的，
     节点上没有 Astro 的 data-astro-cid 属性，普通选择器命中不了，
     必须走 :global()。典型症状：class 明明加上了，样式却不生效。 */
  :global(.cmp-group td) {
    background: var(--paper-100, #f5f7fa);
    padding: 9px 13px;
    border-top: 1px solid var(--line-200);
    border-bottom: 1px solid var(--line-200);
  }
  :global(.cmp-group__zh) {
    font-size: 12px;
