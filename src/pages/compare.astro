  .cmp-pick__en {
    margin-left: 6px;
    font-size: 10.5px;
    color: var(--ink-400);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .cmp-pick__meta {
    font-size: 11px;
    color: var(--ink-500);
    display: flex;
    gap: 8px;
  }
  .cmp-pick__span {
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
  }

  /* ---------------------------------------------------------- 滑块 */
  .cmp-slider {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line-200);
  }
  .cmp-slider[hidden] {
    display: none;
  }
  .cmp-slider__input {
    width: 100%;
    accent-color: var(--blue-600);
    cursor: grab;
  }
  .cmp-slider__input:active {
    cursor: grabbing;
  }
  .cmp-slider__read {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 11.5px;
    color: var(--ink-600);
    margin-top: 2px;
  }
  .cmp-slider__date {
    font-variant-numeric: tabular-nums;
    color: var(--navy-800);
    font-weight: 600;
  }
