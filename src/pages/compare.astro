  /* ---------------------------------------------------------- 提示 */
  .cmp-hint {
    border: 1px dashed var(--line-300);
    border-radius: 10px;
    padding: 26px 20px;
    text-align: center;
    font-size: 13px;
    color: var(--ink-600);
  }

  /* ---------------------------------------------------------- 表
     这一段必须走 :global()。
     Astro 的 scoped style 会给每条规则加 [data-astro-cid-xxx]，而表格的
     <td> 是浏览器脚本用字符串 innerHTML 动态生成的 —— 那些节点上没有
     cid 属性，普通选择器一条都命中不了（表现为「class 加上了但样式不生效」，
     极难看出来）。整个 tbody 都是动态的，所以 .cmp 以下的表格样式一律 global。 */
  .cmp-wrap {
    overflow-x: auto;
    border: 1px solid var(--line-300);
    border-radius: 10px;
    background: #fff;
    /* 同 .cmp：grid/flex 子项默认 min-width:auto，内容撑宽时
       overflow-x 不会触发，整页反而横向溢出。 */
    min-width: 0;
    max-width: 100%;
  }
  .cmp-wrap[hidden] {
    display: none;
  }
  .cmp-table {
    /* 不能用 width:100%：列有 min-width，100% 会让表格去挤列宽、
       最终撑破容器。让表格按内容自然宽，超出部分由外层滚动。 */
    min-width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }
  /* thead 也是脚本动态生成的（renderHead 里 thead.innerHTML = ...），
     所以 .cmp-th 这一族同样必须 :global()。 */
  :global(.cmp-th) {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--navy-900);
    color: #fff;
    text-align: left;
    padding: 10px 13px;
    font-weight: 600;
