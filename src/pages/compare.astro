  @media (max-width: 640px) {
    .cmp__head {
      flex-direction: column;
      align-items: stretch;
    }
    :global(.cmp-th),
    :global(.cmp-td),
    :global(.cmp-k) {
      padding: 8px 9px;
    }
    :global(.cmp-th) {
      min-width: 116px;
