---
// ============================================================================
// 单舰档案页。章节顺序按用户的意见定（2026-11-25 调整）：
//   总图 → 简介 → 状态时间轴 → 详细参数 → 武器配置 → 历史 → 争议 → 图片
//
// 为什么时间轴上提到简介之后：
//   时间轴是这艘舰最核心的交互（拖动横条看不同时刻的状态），
//   放在页面靠前的位置，读者一进来就能玩到它，而不是滚到很下面才发现。
// 为什么详细参数紧跟时间轴：
//   两者是同一批数据的两种读法——时间轴按时刻读，参数表按字段读。
//   分开放会让读者来回滚。
// 武器配置与历史往后放：
//   这两块是深内容，读到这里的人已经决定要认真看了。
// 图片在最后：页首已有总图，其余照片属于「看完正文还想多看的」，
// 所以页首与时间轴区各留一句「更多图片在末尾」的提示。
// ============================================================================
import Base from '../../layouts/Base.astro';
import SideNav from '../../components/SideNav.astro';
import ReportIssue from '../../components/ReportIssue.astro';
import WeaponLink from '../../components/WeaponLink.astro';
import {
  buildShipView,
  buildTimelinePayload,
  getNarratives,
  getBattles,
  getArticle,
  getField,
  getGroups,
  getShips,
  getShip,
  getShipEntities,
  getClass,
  getSource,
  getImagesFor,
  primaryImage,
  imageCredit,
  mergeFactRows,
  displayDate,
  primaryValue,
  enumLabel,
  getCommandersOfShip,
  getRawCommanderFacts,
} from '../../lib/data';

export function getStaticPaths() {
  return getShips().map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const view = buildShipView(id!)!;
const cls = view.classId ? getClass(view.classId) : undefined;
const payload = buildTimelinePayload(view);
// 必须同时传单舰与舰级：武器数据在本项目里存放位置不统一，
// 赤城/加贺/苍龙/飞龙与三艘美军航母把武器写在 ships/ 下，
// 只读舰级会让这些舰的「武器配置」区整块消失（2026-11-21 修的 bug）。
const entities = getShipEntities(getShip(id!), cls);
const narratives = getNarratives(view.id);
const article = getArticle(view.id);
const groups = getGroups();

const hero = primaryImage(`ship:${view.id}`);
const gallery = getImagesFor(`ship:${view.id}`).filter((i) => i.id !== hero?.id);

const battles = getBattles().filter((b) =>
  (b.belligerents ?? []).some((side) =>
    (side.ships ?? []).some((s) => s.ship_id === view.id),
  ),
);

// ------------------------------------------------------------------ 指挥官
// 两路数据：
//   ① 有完整档案的（data/commanders 的 relations 反查）
//   ② 只有 service.commander fact 的（没有人物页）
// ② 要从原始 fact 里剔掉 ① 已经覆盖的人，否则同一个人会出现两次。
const shipCommanders = getCommandersOfShip(view.id);

/** 原始 commander fact 里去掉已被档案覆盖的那些，剩下的就是「只有姓名」的。 */
function parseRawCommander(v: string): { rank: string; name: string } {
  let s = String(v || '').trim();
  if (s.includes('→')) s = s.split('→')[0].trim();
  const m = s.match(/[（(]([^）)]*)[）)]/);
  if (m && m.index !== undefined) {
    s = (s.slice(0, m.index) + ' ' + s.slice(m.index + m[0].length)).trim();
  }
  const RANKS = [
    'Kapitän zur See', 'Kpt.z.S.', 'kmdr por.', 'kmdr',
    'Captain', 'Capt.', 'Commander', 'Cdr.', 'Lieutenant', 'Lt.',
  ];
  let rank = '';
  for (const r of RANKS) {
    if (s.startsWith(r + ' ') || s.startsWith(r + '.')) {
      rank = r.replace(/\.$/, '');
      s = s.slice(r.length).trim().replace(/^\.\s*/, '');
      break;
    }
  }
  const name = s.replace(/(,\s*(?:[A-Z]{2,4}\*?|[A-Z][a-z]{1,3}\*?)\s*)+$/, '')
    .replace(/[,\s]+$/, '');
  return { rank, name };
}

// 判断「这条 fact 里的人是否已有档案」。
//
// ⚠️ 2026-11-23 踩过的坑：第一版用「fact 里的每个词都能在档案全名里找到」
// 当判据，结果 Sherbrooke 与 Vian 同时出现在「有档案」和「无传记资料」两栏 ——
// 因为档案的 name.en 是 "Robert St. Vincent Sherbrooke"，
// 而 fact 解析出来的可能是 "Robert St. Vincent Sherbrooke, RN"（逗号残留），
// 或者反过来档案里带中间名而 fact 里没有。
// 现在改成**姓氏 + 首字母**双判据，只要姓氏一致且首字母对得上就算同一人，
// 比整串包含可靠得多。
const coveredPeople = shipCommanders.map((x) => {
  const en = String(x.commander.name.en || '').toLowerCase().replace(/[.,]/g, '');
  const parts = en.split(/\s+/).filter(Boolean);
  return {
    en,
    surname: parts[parts.length - 1] ?? '',
    firstInitial: (parts[0] ?? '')[0] ?? '',
  };
});

function isCovered(rawName: string): boolean {
  const nm = String(rawName || '').toLowerCase().replace(/[.,]/g, '').trim();
  if (!nm) return false;
  const parts = nm.split(/\s+/).filter(Boolean);
  const surname = parts[parts.length - 1] ?? '';
  const firstInitial = (parts[0] ?? '')[0] ?? '';
  return coveredPeople.some(
    (c) => c.surname === surname && c.firstInitial === firstInitial,
  );
}

const bareCommanders = getRawCommanderFacts()
  .filter((r) => r.shipId === view.id)
  .map((r) => ({ ...r, parsed: parseRawCommander(r.raw) }))
  .filter((r) => !isCovered(r.parsed.name));

const navItems = [
  { href: '#intro', label: '简介' },
  { href: '#timeline', label: '状态时间轴' },
  { href: '#specs', label: '详细参数' },
  ...(entities.weapons.length > 0 ? [{ href: '#armament', label: '武器配置' }] : []),
  ...(article?.history?.length ? [{ href: '#history', label: '历史' }] : []),
  ...(narratives.length > 0 ? [{ href: '#disputes', label: '争议' }] : []),
  ...(gallery.length > 0 ? [{ href: '#gallery', label: '图片' }] : []),
];

/** 来源 id 渲染成带层级角标的小标签，指向原始页面。 */
function srcLink(sid: string) {
  const s = getSource(sid);
  if (!s) return { id: sid, title: sid, url: undefined, tier: 'E' };
  return { id: sid, title: s.title, url: s.url, tier: s.tier };
}

// 归类标签：时代 / 舰种 / 国家。三者都取自同一套取值，
// 分类树用的是同一批数据，页面上得能对上号。
// 舰名后面要不要再补一个「号」字。
// 德英舰名是裸名（Bismarck / Hood / King George V），中文习惯加「号」：
// 俾斯麦号、胡德号。但日美舰名本身已是完整称谓——「企业号」「赤城」，
// 再补一个就变成「企业号号」。判据：名字已经以「号」结尾就不补。
const nameSuffix = view.name.zh.endsWith('号') ? '' : '号';
const displayName = view.name.zh + nameSuffix;

const era = primaryValue(view.id, 'identity.era');
const shipType = primaryValue(view.id, 'identity.ship_type');
const nation = primaryValue(view.id, 'identity.nation');
---

<Base title={displayName}>
  <SideNav
    slot="sidenav"
    kicker={view.className?.en ?? 'Ship'}
    title={view.name.zh}
    items={navItems}
    note="本页按「总图 → 简介 → 状态时间轴 → 详细参数 → 武器配置 → 历史」排列，图片集中在最末。"
  />

  <nav class="crumbs">
    <a href="/">主页</a>
    <span class="sep">/</span>
    <a href="/ships">战舰信息</a>
    <span class="sep">/</span>
    {view.classId && (
      <>
        <a href={`/classes/${view.classId}`}>{view.className?.zh}</a>
        <span class="sep">/</span>
      </>
    )}
    <span>{view.name.zh}</span>
  </nav>

  <!-- ============================== 总图 ============================== -->
  <figure class="shiphero">
    <div class="shiphero__media">
      {hero?.file ? (
        <img src={hero.file} alt={hero.title.zh} />
      ) : (
        <div class="shiphero__noimg">
          <svg viewBox="0 0 640 168" class="shiphero__svg" role="img" aria-label={`${view.name.zh}侧视轮廓示意`}>
            <path d="M44 118 L58 104 L520 100 L578 96 L604 108 L606 118 Z" />
            <path d="M58 104 L520 100" />
            <path d="M120 104 L120 92 L180 92 L180 100" />
            <path d="M196 104 L196 86 L262 86 L262 100" />
            <path d="M296 100 L296 62 L318 54 L340 62 L340 100" />
            <path d="M356 100 L356 74 L392 74 L392 100" />
            <path d="M404 100 L404 68 L438 68 L438 100" />
            <path d="M188 92 l0 -22 M224 92 l0 -22" />
            <path d="M436 100 l0 -20 M472 100 l0 -20" />
            <path d="M40 140 L610 134" stroke-dasharray="7 6" />
          </svg>
          <div class="shiphero__noimgtext">配图待补 · 此处将放置该舰公有领域或已授权照片</div>
        </div>
      )}
    </div>
    <figcaption class="shiphero__cap">
      <span class="shiphero__captitle">
        {hero ? hero.title.zh : `${displayName} 侧视轮廓（示意图，非照片）`}
      </span>
      {hero ? (
        <span class="shiphero__credit">
          {imageCredit(hero)}
          {hero.source_url && (
            <>
              {' · '}
              <a href={hero.source_url} target="_blank" rel="noopener noreferrer">原始页面</a>
            </>
          )}
          <span class:list={['tag', 'tiny', `tag--lic-${hero.license_tier}`]}>
            授权 {hero.license_tier} 档
          </span>
        </span>
      ) : (
        <span class="shiphero__credit">
          图片来源按授权分三档：A 档可归档，B 档外链并署名，C 档不使用。
        </span>
      )}
      {gallery.length > 0 && (
        <span class="shiphero__more">
          <a href="#gallery">共 {gallery.length + (hero ? 1 : 0)} 张照片，更多图片在页面末尾 ↓</a>
        </span>
      )}
    </figcaption>
  </figure>

  <div class="pagehead pagehead--tight">
    <div class="pagehead__kicker">Ship record · {view.name.en}</div>
    <h1 class="pagehead__title">
      {displayName}
      {view.className && <span class="pagehead__badge">{view.className.zh}</span>}
    </h1>
    <div class="pagehead__meta">
      {era && <span class="tag tag--ghost">{enumLabel(era, 'zh')}</span>}
      {shipType && <span class="tag tag--ghost">{enumLabel(shipType, 'zh')}</span>}
      {nation && <span class="tag tag--ghost">{enumLabel(nation, 'zh')}</span>}
      <span class="tag tag--dark">{view.facts.length} 条数据</span>
      {narratives.length > 0 && <span class="tag tag--warn">{narratives.length} 条存疑</span>}
      <span class="tag tag--ghost">时间跨度 {view.range.from} → {view.range.to}</span>
    </div>
  </div>

  <!-- ============================== 简介 ============================== -->
  {
    article?.intro && (
      <section class="section" id="intro">
        <div class="section__head">
          <h2 class="section__title">简介</h2>
          <span class="section__en">Introduction</span>
        </div>

        {article.intro.lead && <p class="lead">{article.intro.lead.zh}</p>}

        {(article.intro.paragraphs ?? []).map((p) => (
          <div class="prose">
            {p.heading && <h3 class="prose__h">{p.heading}</h3>}
            <p class="prose__p">{p.text.zh}</p>
            {p.src && p.src.length > 0 && (
              <div class="srcline">
                {p.src.map((sid) => {
                  const s = srcLink(sid);
                  return (
                    <a class="srcchip" href={s.url} target="_blank" rel="noopener noreferrer">
                      <span class={`conf conf--${s.tier}`}>{s.tier}</span>
                      {s.title}
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        ))}

        {!article.intro.paragraphs?.length && (
          <p class="muted small">这一舰的简介还在写。数据部分已经可用。</p>
        )}
      </section>
    )
  }

  <!-- ============================ 状态时间轴 ============================ -->
  <section class="section" id="timeline">
    <div class="section__head">
      <h2 class="section__title">状态时间轴</h2>
      <span class="section__en">State timeline</span>
      <span class="section__aside">拖动横条或点切片</span>
    </div>
    <p class="section__sub">
      同一艘舰在不同日期的参数并不同。拖动横条，下面只显示该时刻成立的取值。
      没显示出来不代表是 0，而是「未记载」。
      {gallery.length > 0 && (
        <>
          {' '}
          <a class="sub-anchor" href="#gallery">该舰的 {gallery.length + (hero ? 1 : 0)} 张照片在页面末尾 →</a>
        </>
      )}
    </p>

    <div class="timeline" id="tl">
      <div class="timeline__head">
        <span class="timeline__date" id="tl-date">{payload.range.from}</span>
        <span class="timeline__slice" id="tl-slice"></span>
      </div>

      <div class="timeline__body">
        <div class="tl-track">
          <div class="tl-rail"></div>
          <div class="tl-fill" id="tl-fill"></div>
          <div class="tl-knob" id="tl-knob"></div>
          <input
            class="tl-range"
            id="tl-range"
            type="range"
            min="0"
            max="1000"
            value="0"
            step="1"
            aria-label="时间轴：拖动查看不同日期的状态"
          />
        </div>
        <div class="tl-labels" id="tl-labels"></div>
        <div class="tl-slices" id="tl-slices"></div>

        <!-- 当前切片对应的照片。放在切片条与字段表之间：
             读者的视线是「拖到哪个时期 → 那是艘什么状态的船 → 那时期的数据」，
             图正好卡在这个顺序上。 -->
        <figure class="tl-pic" id="tl-pic" hidden>
          <img id="tl-pic-img" alt="" loading="lazy" />
          <figcaption>
            <span class="tl-pic__t" id="tl-pic-title"></span>
            <span class="tl-pic__c">
              <span id="tl-pic-credit"></span>
              <span class="tag tiny" id="tl-pic-tier"></span>
              <a id="tl-pic-url" target="_blank" rel="noopener noreferrer" hidden>原始页面</a>
            </span>
            <span class="tl-pic__n" id="tl-pic-note"></span>
          </figcaption>
        </figure>

        <label class="tl-toggle">
          <input type="checkbox" id="tl-all" />
          <span>显示全部字段（默认只显示会随时间变化的）</span>
        </label>
      </div>

      <div class="tl-body" id="tl-body">
        <div class="empty">
          <div class="empty__title">载入中</div>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ payload }}>
    const boxes = document.getElementById('tl-body');
    const rangeInput = document.getElementById('tl-range');
    const dateEl = document.getElementById('tl-date');
    const sliceEl = document.getElementById('tl-slice');
    const fillEl = document.getElementById('tl-fill');
    const knobEl = document.getElementById('tl-knob');
    const labelsEl = document.getElementById('tl-labels');
    const chipsEl = document.getElementById('tl-slices');
    const allToggle = document.getElementById('tl-all');

    // DAY 必须在任何调用 num() 之前初始化：const 是 TDZ，
    // 写在 from 之后会让整个脚本抛 "Cannot access 'DAY' before initialization"。
    const DAY = 86400000;

    const from = num(payload.range.from);
    const to = num(payload.range.to);
    const MIN = from;
    const MAX = to === from ? from + 1 : to;

    // 日期一律换算成「距 1970-01-01 的天数」。不能把 YYYYMMDD 当十进制数
    // 直接加减：那样 19351116 + 14949 会算出 19366065，刻度年份全错。
    function num(s) {
      if (!s) return 99999999;
      const p = String(s).split('-').map((x) => parseInt(x, 10));
      return Date.UTC(p[0] || 1900, (p[1] || 1) - 1, p[2] || 1) / DAY;
    }
    function numToDate(n) {
      const d = new Date(Math.round(n) * DAY);
      const pad = (x) => String(x).padStart(2, '0');
      return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
    }
    function hit(win, t) {
      const a = win.from ? num(win.from) : -Infinity;
      const b = win.to ? num(win.to) : Infinity;
      return a <= t && t <= b;
    }
    function pct(t) {
      return Math.max(0, Math.min(100, ((t - MIN) / (MAX - MIN)) * 100));
    }

    const ticks = [];
    for (let i = 0; i <= 4; i++) ticks.push(MIN + ((MAX - MIN) * i) / 4);
    labelsEl.innerHTML = ticks
      .map((t) => `<span style="left:${pct(t)}%">${numToDate(t).slice(0, 7)}</span>`)
      .join('');

    if (payload.slices?.length) {
      chipsEl.innerHTML = payload.slices
        .map(
          (s, i) =>
            `<button class="tl-chip" data-i="${i}">` +
            (s.pic
              ? `<img class="tl-chip__pic" src="${s.pic.file}" alt="" loading="lazy" />`
              : `<span class="tl-chip__nop">无图</span>`) +
            `<span class="tl-chip__body"><span class="tl-chip__code">${s.code}</span>${s.title}</span>` +
            `</button>`,
        )
        .join('');
      chipsEl.querySelectorAll('.tl-chip').forEach((b) => {
        b.addEventListener('click', () => {
          const s = payload.slices[+b.dataset.i];
          setT(num(s.from) + 1);
        });
      });
    }

    const picEl = document.getElementById('tl-pic');
    const picImg = document.getElementById('tl-pic-img');
    const picTitle = document.getElementById('tl-pic-title');
    const picCredit = document.getElementById('tl-pic-credit');
    const picTier = document.getElementById('tl-pic-tier');
    const picUrl = document.getElementById('tl-pic-url');
    const picNote = document.getElementById('tl-pic-note');

    /**
     * 切片换图。没有图的切片要显式藏起来，不能留着上一片的老图——
     * 那会让人以为 1955 年退役时舰还是 1940 年那个样子。
     */
    function showSlicePic(s) {
      const pic = s?.pic;
      if (!picEl) return;
      if (!pic) {
        picEl.hidden = true;
        return;
      }
      picEl.hidden = false;
      picImg.src = pic.file;
      picImg.alt = pic.title;
      picTitle.textContent = pic.title;
      picCredit.textContent = pic.credit || '';
      picTier.textContent = pic.tier + ' 档';
      picTier.className = 'tag tag--lic-' + pic.tier + ' tiny';
      if (pic.url) {
        picUrl.href = pic.url;
        picUrl.hidden = false;
      } else {
        picUrl.hidden = true;
      }
      // 只有「窗外最近一张」才需要提示；窗内的照片本来就是这个时期的样子。
      picNote.textContent =
        pic.how === 'nearest'
          ? '该时期内没有已归档的照片，这是时间上最接近的一张。' + (pic.note ? ' ' + pic.note : '')
          : pic.note || '';
    }

    function currentSlice(t) {
      return (payload.slices ?? []).find((s) => {
        const a = num(s.from);
        const b = s.to ? num(s.to) : Infinity;
        return a <= t && t <= b;
      });
    }

    function render(t) {
      const showAll = allToggle?.checked;
      const rows = [];
      for (const g of payload.groups) {
        const fields = payload.fields.filter((f) => f.group === g.id);
        const live = [];
        for (const f of fields) {
          // 默认只显示会变的字段：全长 250.5 m 这种一辈子一个值，列出来是噪音。
          if (!showAll && f.windows.length < 2) continue;
          const ws = f.windows.filter((w) => hit(w, t));
          if (ws.length === 0) continue;
          live.push({ f, ws });
        }
        if (live.length === 0) continue;
        rows.push(
          `<div class="tl-group"><div class="tl-group__title">${g.label.zh}<span>${g.label.en}</span></div>` +
            live
              .map(
                ({ f, ws }) =>
                  `<div class="datarow"><div class="datarow__k">${f.label.zh}</div>` +
                  `<div class="datarow__v">${ws.map((w) => w.text).join(' <span class="muted">/</span> ')}` +
                  (ws.some((w) => w.disputed)
                    ? `<span class="tag tag--warn tiny">存在争议</span>`
                    : '') +
                  `</div>` +
                  `<div class="datarow__meta">${
                    ws[0].conf ? `<span class="conf conf--${ws[0].conf}">${ws[0].conf}</span>` : ''
                  }</div></div>`,
              )
              .join('') +
            `</div>`,
        );
      }
      boxes.innerHTML =
        rows.length > 0
          ? rows.join('')
          : `<div class="empty"><div class="empty__title">这一天没有记录</div><div class="empty__text">数据里没有覆盖该日期的时间窗。这不是「没有」，是「未记载」。</div></div>`;
    }

    let lastT = -1;
    function setT(t) {
      t = Math.max(MIN, Math.min(MAX, Math.round(t)));
      if (t === lastT) return;
      lastT = t;
      dateEl.textContent = numToDate(t);
      const p = pct(t);
      fillEl.style.width = p + '%';
      knobEl.style.left = p + '%';
      rangeInput.value = String(Math.round(((t - MIN) / (MAX - MIN)) * 1000));
      const s = currentSlice(t);
      sliceEl.textContent = s ? `${s.code} · ${s.title}` : '';
      chipsEl.querySelectorAll('.tl-chip').forEach((b, i) => {
        b.classList.toggle('tl-chip--on', !!s && payload.slices[i].code === s.code);
      });
      showSlicePic(s);
      render(t);
    }

    rangeInput.addEventListener('input', () => {
      const v = +rangeInput.value;
      setT(MIN + ((MAX - MIN) * v) / 1000);
    });

    allToggle?.addEventListener('change', () => {
      const keep = lastT;
      lastT = -1;
      setT(keep);
    });

    // 默认定位：优先 S3（俾斯麦号"全战备"那一刀），没有就取跨度最长的一刀。
    // 用 S3 写死是因为它是读者最想看的状态；但不能只认 S3——
    // 提尔皮茨的切片编号是 T0–T6，硬套 S3 会退到 MIN（1936 年开工日），
    // 一进来就是一片空白。跨度最长的切片通常就是"它最有代表性的那段常态"。
    // （这里的 script 是纯 JS 不是 TS，写不了 `!` 断言，故先过滤再取。）
    const slicesArr = payload.slices ?? [];
    const closed = slicesArr
      .filter((s) => s.to)
      .sort((a, b) => num(b.to) - num(b.from) - (num(a.to) - num(a.from)));
    const pick = slicesArr.find((s) => s.code === 'S3') ?? closed[0];
    setT(pick ? num(pick.from) + 1 : MIN);
  </script>

  <!-- ============================ 详细参数 ============================ -->
  <section class="section" id="specs">
    <div class="section__head">
      <h2 class="section__title">详细参数</h2>
      <span class="section__en">Characteristics</span>
    </div>
    <p class="section__sub">
      下面列出全生命期出现过的所有取值。同一字段出现多行，说明它在服役期间变过，
      或者不同来源给出的数不一样。
    </p>

    {
      groups.map((g) => {
        const fields = payload.fields.filter((f) => f.group === g.id);
        if (fields.length === 0) return null;
        return (
          <div class="group-block">
            <div class="group-block__title">
              {g.label.zh}
              <span>{g.label.en}</span>
            </div>
            {fields.map((f) => (
              <div class="datarow">
                <div class="datarow__k">{f.label.zh}</div>
                <div
                  class:list={[
                    'datarow__v',
                    { 'datarow__v--long': f.windows.some((w) => w.text.length > 42) },
                  ]}
                >
                  {f.windows.map((w, i) => (
                    <>
                      {i > 0 && <span class="muted"> · </span>}
                      <span class={w.disputed ? 'is-disputed' : ''}>{w.text}</span>
                      {f.windows.length > 1 && (w.from || w.to) && (
                        <span class="tiny muted">
                          （{w.from ?? '—'} ~ {w.to ?? '今'}）
                        </span>
                      )}
                    </>
                  ))}
                </div>
                <div class="datarow__meta">
                  {f.windows[0]?.conf && (
                    <span class={`conf conf--${f.windows[0].conf}`}>{f.windows[0].conf}</span>
                  )}
                  {f.windows.some((w) => w.disputed) && (
                    <span class="tag tag--warn tiny">存在争议</span>
                  )}
                  <ReportIssue
                    entity={view.id}
                    entityLabel={view.name?.zh ?? view.id}
                    field={f.id}
                    fieldLabel={f.label.zh}
                    current={f.windows.map((w) => w.text).join(' / ')}
                    sources={f.windows[0]?.src}
                    kind="ship"
                  />
                </div>
              </div>
            ))}
          </div>
        );
      })
    }
  </section>

  <!-- ============================ 武器配置 ============================ -->
  {
    entities.weapons.length > 0 && (
      <section class="section" id="armament">
        <div class="section__head">
          <h2 class="section__title">武器配置</h2>
          <span class="section__en">Armament</span>
          <span class="section__aside">{entities.weapons.length} 种</span>
        </div>
        <p class="section__sub">
          按武器型号分组，每组下面是这型炮在舰上的具体炮位。
          参数里凡是能随时间变化的（比如炮塔测距仪），都标了生效区间。
        </p>

        <div class="stack">
          {entities.weapons.map((w) => (
            <div class="weapon">
              <div class="weapon__head">
                <h3 class="weapon__title">
                  <WeaponLink id={w.id} label={w.label} />
                </h3>
                <span class="tag tag--ghost">{w.facts.length} 条参数</span>
                <a class="weapon__more" href={`/weapons/${w.id}/`}>
                  武器详情
                  <span aria-hidden="true">→</span>
                </a>
              </div>
              <div class="weapon__body">
                <div class="weapon__facts">
                  {mergeFactRows(w.facts).map((r) => {
                    const def = getField(r.field);
                    if (!def) return null;
                    // 四列网格里，长值必须横跨整行，否则被挤成窄条读不下去。
                    // 判据用合并后的实际显示文本长度（含限定词），不是单个 fact 的值。
                    const isLong = r.text.length > 42 || r.pairs.length > 0;
                    return (
                      <div
                        class:list={[
                          'datarow',
                          'datarow--tight',
                          { 'weapon__row--wide': isLong },
                        ]}
                      >
                        <div class="datarow__k datarow__k--wrap">{def.label.zh}</div>
                        <div
                          class:list={[
                            'datarow__v',
                            { 'datarow__v--long': r.text.length > 42 },
                          ]}
                        >
                          {r.pairs.length > 0 ? (
                            <span class="pairlist">
                              {r.pairs.map((p) => (
                                <span class="pair">
                                  <span class="pair__q">{p.q}</span>
                                  <span class="pair__t">{p.t}</span>
                                </span>
                              ))}
                            </span>
                          ) : (
                            r.text
                          )}
                          {r.disputed && <span class="tag tag--warn tiny">存在争议</span>}
                        </div>
                        <div class="datarow__meta">
                          {r.conf && <span class={`conf conf--${r.conf}`}>{r.conf}</span>}
                        </div>
                      </div>
                    );
                  })}
                </div>
                {w.mounts.length > 0 && (
                  <div class="mountbox">
                    <div class="mountbox__title">炮位</div>
                    {w.mounts.map((m) => (
                      <a class="mountbox__row" href={`/weapons/${w.id}/#mounts`}>
                        <span class="mountbox__name">{m.label}</span>
                        <span class="mountbox__n">{m.facts.length} 条</span>
                        <span class="mountbox__arrow" aria-hidden="true">→</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ============================== 历史 ============================== -->
  {
    article?.history && article.history.length > 0 && (
      <section class="section" id="history">
        <div class="section__head">
          <h2 class="section__title">历史</h2>
          <span class="section__en">History</span>
          <span class="section__aside">
            {article.history.reduce((n, s) => n + (s.events?.length ?? 0), 0)} 条事件
          </span>
        </div>

        <div class="hist">
          {article.history.map((sec) => (
            <div class="hist__sec">
              <div class="hist__head">
                <h3 class="hist__title">{sec.title.zh}</h3>
                {sec.range && (
                  <span class="hist__range mono">
                    {displayDate(sec.range.from)}
                    {sec.range.to ? ` — ${displayDate(sec.range.to)}` : ' 起'}
                  </span>
                )}
              </div>
              {sec.lead && <p class="hist__lead">{sec.lead.zh}</p>}
              <div class="hist__events">
                {(sec.events ?? []).map((ev) => (
                  <div class="hist__ev">
                    <div class="hist__date mono">{displayDate(ev.date)}</div>
                    <div class="hist__text">
                      {ev.text.zh}
                      {ev.src && ev.src.length > 0 && (
                        <div class="srcline srcline--inline">
                          {ev.src.map((sid) => {
                            const s = srcLink(sid);
                            return (
                              <a
                                class="srcchip srcchip--sm"
                                href={s.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                title={s.title}
                              >
                                <span class={`conf conf--${s.tier}`}>{s.tier}</span>
                                {s.id}
                              </a>
                            );
                          })}
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        {battles.length > 0 && (
          <div class="btllist">
            <div class="btllist__title">相关战役</div>
            {battles.map((b) => (
              <a class="btlrow" href={`/battles/${b.id}`}>
                <span class="btlrow__date mono">{b.date.from}</span>
                <span class="btlrow__body">
                  <span class="btlrow__name">{b.name.zh}</span>
                  <span class="btlrow__en">{b.name.en}</span>
                </span>
                <span class="btlrow__n">{b.timeline.length} 个事件</span>
                <span class="btlrow__arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        )}

        <!-- 历任指挥官（2026-11-23 新增，与 /commanders 双向跳转）
             数据来源两处：
               ① 有完整档案的（13 人）→ 可点进人物页
               ② 只有 name+军衔+任期 的（其余）→ 只列一行，不链接
             都来自 data/ships 里既有的 service.commander fact，
             加上 data/commanders/*.yaml 的 relations 反查。 -->
        {(shipCommanders.length > 0 || bareCommanders.length > 0) && (
          <div class="cmdrbox">
            <div class="btllist__title">
              历任指挥官
              <span class="cmdrbox__n">
                {shipCommanders.length + bareCommanders.length} 条任期记录
              </span>
            </div>

            {shipCommanders.map(({ commander, tenure }) => (
              <a class="cdrow" href={`/commanders/${commander.id}`}>
                <span class="cdrow__date mono">
                  {tenure.from || '—'} → {tenure.to || '—'}
                </span>
                <span class="cdrow__body">
                  <span class="cdrow__name">{commander.name.zh}</span>
                  <span class="cdrow__rank">{commander.rank_at_post ?? commander.rank_final}</span>
                </span>
                <span class="cdrow__role">{tenure.role}</span>
                <span class="cdrow__arrow" aria-hidden="true">→</span>
              </a>
            ))}

            {bareCommanders.map((b) => (
              <div class="cdrow cdrow--bare">
                <span class="cdrow__date mono">
                  {b.from || '—'} → {b.to || '—'}
                </span>
                <span class="cdrow__body">
                  <span class="cdrow__name">{b.parsed.name}</span>
                  <span class="cdrow__rank">{b.parsed.rank}</span>
                </span>
                <span class="cdrow__role cdrow__role--mute">无传记资料</span>
                <span class="cdrow__arrow cdrow__arrow--none" aria-hidden="true">·</span>
              </div>
            ))}

            <p class="cmdrbox__note">
              标「无传记资料」的是只有姓名与任期的记录 ——
              本站查不到这些人的生平，所以不为他们建人物页。
              给一个只有名字的人编简历会毁掉整站的可追溯性。
            </p>
          </div>
        )}
      </section>
    )
  }

  <!-- ============================== 争议 ============================== -->
  {
    narratives.length > 0 && (
      <section class="section" id="disputes">
        <div class="section__head">
          <h2 class="section__title">存在争议的问题</h2>
          <span class="section__en">Contested</span>
          <span class="section__aside">{narratives.length} 条</span>
        </div>
        <p class="section__sub">
          这些问题的不同说法并列保留，不做裁决。标蓝的是学界主流看法，但它不是定论。
        </p>
        {narratives.map((n) => (
          <details class="narrative">
            <summary>
              <span class="tag tag--warn tiny">{n.positions.length} 种说法</span>
              {n.question.zh}
            </summary>
            <div class="narrative__body">
              {n.positions.map((p) => (
                <div
                  class={`position ${p.id === n.current_consensus ? 'position--consensus' : ''}`}
                >
                  <div class="position__head">
                    <span class="position__claim">{p.claim.zh}</span>
                    {p.id === n.current_consensus && <span class="tag tiny">主流</span>}
                    <span class="position__by">{p.held_by}</span>
                  </div>
                  {p.evidence && <p class="position__text">{p.evidence}</p>}
                </div>
              ))}
              {n.note && (
                <div class="note">
                  <strong>为什么没有定论：</strong>
                  {n.note}
                </div>
              )}
            </div>
          </details>
        ))}
      </section>
    )
  }

  <!-- ============================== 图集 ============================== -->
  {
    gallery.length > 0 && (
      <section class="section" id="gallery">
        <div class="section__head">
          <h2 class="section__title">图片</h2>
          <span class="section__en">Photographs</span>
          <span class="section__aside">{gallery.length} 张</span>
        </div>
        <div class="gallery">
          {gallery.map((img) => (
            <figure class="gallery__item">
              {img.file ? (
                <a href={img.source_url} target="_blank" rel="noopener noreferrer">
                  <img src={img.file} alt={img.title.zh} loading="lazy" />
                </a>
              ) : (
                <div class="gallery__noimg">外链图 · 未归档</div>
              )}
              <figcaption>
                <span class="gallery__title">{img.title.zh}</span>
                <span class="gallery__credit">
                  {imageCredit(img)}
                  <span class:list={['tag', 'tiny', `tag--lic-${img.license_tier}`]}>
                    {img.license_tier}
                  </span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }
</Base>

