    overflow: hidden;
  }
  .weapon__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 15px;
    background: linear-gradient(150deg, var(--blue-50), var(--white));
    border-bottom: 1px solid var(--line-soft);
  }
  .weapon__title {
    font-size: 14.5px;
    font-weight: 680;
    color: var(--ink-900);
    margin: 0;
  }
  /* 「武器详情 →」放在标题栏最右，和计数标签拉开 */
  .weapon__more {
    margin-left: auto;
    font-size: 11.5px;
    color: var(--blue-700);
    text-decoration: none;
    white-space: nowrap;
    padding: 2px 7px;
    border: 1px solid var(--blue-200);
    border-radius: var(--radius-sm);
    background: var(--white);
    transition: background 0.15s, border-color 0.15s;
  }
  .weapon__more:hover,
  .weapon__more:focus-visible {
    background: var(--blue-50);
    border-color: var(--blue-400);
    outline: none;
  }
  .weapon__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
    gap: 0;
  }
  .weapon__facts {
    padding: 0 15px 12px;
    min-width: 0;
    /* 2026-11-25 第三版：按 `列表示意.jpg` 做成带格线的表格。
       图纸的三层含义，逐条落实：
         ① 「字段 | 值」这一对保持并排 —— 不是上下叠
         ② 两对并排放成一排 —— 视觉上是四列 [字段1][值1][字段2][值2]
         ③ **有框、有列线、有行线** —— 是格子，不是几条下划线
       实现：容器 4 列，每条 datarow 占 2 列（span 2），内部再分「字段|值」两格。
       格线靠相邻边界画（避免双线）：列线画在字段格的右边，行线画在整条的下边，
       外框由容器自己一圈 border。 */
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border: 1px solid var(--line-strong, var(--line));
    border-radius: var(--radius-sm, 4px);
    overflow: hidden;
    background: var(--white);
  }
  .weapon__facts > .datarow--tight {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(0, 92px) minmax(0, 1fr);
    align-items: stretch;
    min-width: 0;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  /* 左半页（第 1、2 条所在的那一对）右边补一条列线；
     右半页（第 2 条那一对）不再补，靠外框收边，避免出现双线。 */
  .weapon__facts > .datarow--tight:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  /* 最后一行按奇偶决定是否去掉底线：让表格收口干净 */
  .weapon__facts > .datarow--tight:nth-last-child(1):nth-child(odd),
  .weapon__facts > .datarow--tight:nth-last-child(2):nth-child(odd) {
    border-bottom: 0;
  }
  .weapon__facts > .datarow--tight > .datarow__k {
    font-size: 12px;
    color: var(--ink-500);
    padding: 6px 8px;
    border-right: 1px solid var(--line-soft, var(--line));
    min-width: 0;
    overflow-wrap: anywhere;
    background: var(--paper);
    display: flex;
    align-items: center;
  }
  .weapon__facts > .datarow--tight > .datarow__v {
    font-size: 12.5px;
    line-height: 1.55;
    padding: 6px 9px;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }
  /* 置信度角标：原来占第三格会把行高撑成两行、表格立刻不齐。
     改成绝对定位的小角标，浮在值那一格右下角，不参与布局。 */
  .weapon__facts > .datarow--tight > .datarow__meta {
    position: absolute;
    right: 5px;
    bottom: 2px;
    font-size: 9px;
    line-height: 1;
    pointer-events: none;
    opacity: 0.75;
