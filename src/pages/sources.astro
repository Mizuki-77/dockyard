---
import Base from '../layouts/Base.astro';
import SideNav from '../components/SideNav.astro';
import { getSources, getTiers } from '../lib/data';

const sources = getSources();
const tiers = getTiers();

const tierOrder = ['A', 'B', 'C', 'D', 'E'];
const byTier = new Map<string, typeof sources>();
for (const s of sources) {
  const arr = byTier.get(s.tier ?? 'E') ?? [];
  arr.push(s);
  byTier.set(s.tier ?? 'E', arr);
}

const STATUS_LABEL: Record<string, string> = {
  ok: '已获取',
  not_fetched: '尚未抓取',
  blocked: '访问受阻',
  gone: '页面已失效',
};

const ROLE_LABEL: Record<string, string> = {
  data: '数据',
  narrative: '叙事',
  rights: '授权条款',
  lead: '线索',
  image: '图源',
};
---

<Base title="资料来源">
  <SideNav
    slot="sidenav"
    kicker="Provenance"
    title="资料来源"
    items={[
      { href: '/ships', label: '战舰信息' },
      { href: '/weapons', label: '武器与装备' },
      { href: '/sources', label: '资料来源' },
      { href: '/help', label: '帮助及反馈' },
    ]}
    note="每条数据都能追溯到这里的某一条来源。没有来源的数据不写进档案。"
  />

  <div class="pagehead">
    <div class="pagehead__kicker">Provenance</div>
    <h1 class="pagehead__title">资料来源</h1>
    <p class="pagehead__sub">
      共登记 {sources.length} 条来源。每条数据都指向其中之一，并标注证据层级。
      层级低的来源不是"不重要"，而是它提供的线索必须回到层级高的来源去验证。
    </p>
  </div>

  <section class="section">
    <div class="section__head">
      <h2 class="section__title">证据层级</h2>
      <span class="section__en">Evidence tiers</span>
    </div>
    <div class="stack">
      {
        tierOrder.map((t) => {
          const def = tiers.find((x) => x.id === t);
          const list = (byTier.get(t) ?? []).sort((a, b) => a.id.localeCompare(b.id));
          if (!def) return null;
          return (
            <div class="tierblock">
              <div class="tierblock__head">
                <span class={`conf conf--${t}`}>{t}</span>
                <span class="tierblock__label">{def.label.zh}</span>
                <span class="tierblock__count">{list.length} 条</span>
              </div>
              <p class="tierblock__desc">{def.desc}</p>
              {list.length > 0 && (
                <div class="srclist">
                  {list.map((s) => (
                    <div class="srcitem">
                      <div class="srcitem__main">
                        <a class="srcitem__title" href={s.url} target="_blank" rel="noopener noreferrer">
                          {s.title}
                        </a>
                        <span class="srcitem__id">{s.id}</span>
                        {s.status && s.status !== 'ok' && (
                          <span class="tag tag--warn tiny">{STATUS_LABEL[s.status] ?? s.status}</span>
                        )}
                        {(s.role ?? []).map((r) => (
                          <span class="tag tag--ghost tiny">{ROLE_LABEL[r] ?? r}</span>
                        ))}
                      </div>
                      {s.note && <p class="srcitem__note">{s.note}</p>}
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })
      }
    </div>
  </section>
</Base>

<style>
  .tierblock {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    padding: 18px 20px;
  }
  .tierblock + .tierblock {
    margin-top: 14px;
  }
  .tierblock__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }
  .tierblock__label {
    font-size: 14px;
    font-weight: 680;
    color: var(--ink-900);
  }
  .tierblock__count {
    margin-left: auto;
    font-size: 11.5px;
    color: var(--ink-300);
    font-family: var(--font-mono);
  }
  .tierblock__desc {
    font-size: 12.5px;
    color: var(--ink-500);
    line-height: 1.65;
    margin: 0 0 12px;
  }

  .srclist {
    border-top: 1px dashed var(--line);
    padding-top: 4px;
  }
  .srcitem {
    padding: 9px 0;
    border-bottom: 1px dashed var(--line-soft);
  }
  .srcitem:last-child {
    border-bottom: 0;
  }
  .srcitem__main {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
  }
  .srcitem__title {
    font-size: 13px;
    font-weight: 600;
    color: var(--blue-700);
    text-decoration: none;
  }
  .srcitem__title:hover {
    text-decoration: underline;
  }
  .srcitem__id {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-300);
  }
  .srcitem__note {
    font-size: 12px;
    color: var(--ink-500);
    line-height: 1.62;
    margin: 5px 0 0;
  }
</style>
