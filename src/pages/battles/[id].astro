---
import Base from '../../layouts/Base.astro';
import CatalogTree from '../../components/CatalogTree.astro';
import ReportIssue from '../../components/ReportIssue.astro';
import { getBattles, getBattle, getSource, getImagesFor, primaryImage, imageCredit, operationOf } from '../../lib/data';
import { buildBattleTree } from '../../lib/tree';

export function getStaticPaths() {
  return getBattles().map((b) => ({ params: { id: b.id } }));
}

const { id } = Astro.params;
const b = getBattle(id!)!;
const sides = b.belligerents ?? [];
const hero = primaryImage(`battle:${b.id}`);
const gallery = getImagesFor(`battle:${b.id}`).filter((i) => i.id !== hero?.id);
/* 上级行动：给读者一条回上游的路。没有上层行动的战斗返回 undefined。 */
const op = operationOf(b.id);
/* 同一行动里的其他战斗——一场行动往往有几场，读者会想横向对照。 */
const siblings = op
  ? (op.phases ?? [])
      .filter((p) => p.battle && p.battle !== b.id)
      .map((p) => ({ phase: p, battle: getBattle(p.battle!) }))
      .filter((x): x is { phase: typeof x.phase; battle: NonNullable<typeof x.battle> } => Boolean(x.battle))
  : [];

/* ---- 左树：与「海战历史」列表页同构的三层树（海区 → 年份 → 战斗），
        选中当前这场。战斗页上保留完整索引，是为了让读者
        横向跳到同一片海里的另一场仗，而不用先退回列表。
        装配逻辑在 src/lib/tree.ts，两页共用。 ---- */
const allBattles = getBattles();
const battleTree = buildBattleTree(allBattles, (x) => operationOf(x.id)?.name.zh);

const branches = battleTree.map((t) => ({
  key: t.key,
  label: t.label,
  en: t.en,
  count: t.count,
  groups: t.years.map((y) => ({
    key: y.key,
    label: y.label,
    count: y.count,
    leaves: y.battles.map((x) => ({
      label: x.label,
      href: x.href,
      meta: x.meta ?? '',
    })),
  })),
}));

/**
 * 战斗时间轴不是等间隔的：先把时刻换算成分钟，再按跨度给比例。
 *
 * 支持两种写法：
 *   '05:52'        —— 单日战斗（如丹麦海峡），只有时刻
 *   '05-26 20:47'  —— 跨日战斗（如最终战），带 MM-DD
 * 跨日时把日号乘进分钟里，否则「23:58 之后接 01:22」会被算成倒流。
 */
function tmin(s?: string): number | null {
  if (!s) return null;
  const str = String(s);
  const withDay = str.match(/^(\d{1,2})-(\d{1,2})\s+(\d{1,2}):(\d{2})(?::(\d{2}))?$/);
  if (withDay) {
    return (
      Number(withDay[1]) * 1440 +
      Number(withDay[2]) * 60 +
      Number(withDay[3]) * 60 +
      Number(withDay[4]) +
      Number(withDay[5] ?? 0) / 60
    );
  }
  const m = str.match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?$/);
  if (!m) return null;
  return Number(m[1]) * 60 + Number(m[2]) + Number(m[3] ?? 0) / 60;
}

/** 把 '05-26 20:47' 拆成「日期 / 时刻」两段显示；只有时刻时 date 为空。 */
function tsplit(s?: string): { date: string; time: string } {
  const str = String(s ?? '');
  const withDay = str.match(/^(\d{1,2})-(\d{1,2})\s+(\d{1,2}:\d{2}(?::\d{2})?)$/);
  if (withDay) return { date: `${withDay[1]}.${withDay[2]}`, time: withDay[3] };
  return { date: '', time: str };
}
const first = tmin(b.timeline[0]?.time);
const last = tmin(b.timeline[b.timeline.length - 1]?.time);
const span = first !== null && last !== null && last > first ? last - first : 1;

// 概览密度只显示标了 major 的条目。
// 没标任何 major 时（现存的 denmark-strait / last-battle 都还没标），
// 不显示切换按钮，退化成原来的「全部显示」——不给读者一个点了没反应的控件。
const majorCount = (b.timeline ?? []).filter((ev) => ev.major).length;

const srcIds = new Set<string>();
for (const ev of [...(b.timeline ?? []), ...(b.hits_received ?? []), ...(b.consequences ?? [])]) {
  for (const s of ev.src ?? []) srcIds.add(s);
}
const usedSources = [...srcIds].map((s) => getSource(s)).filter(Boolean);
---

<Base title={b.name.zh} variant="tree">
  <CatalogTree
    slot="sidenav"
    kicker="Battles"
    title="海战历史"
    branches={branches}
    currentHref={`/battles/${b.id}`}
    footLink={{ href: '/operations', label: '按行动看' }}
    note="索引按海区与年份排列。同一场行动里的几场战斗，可以从战斗页顶部回到行动全程。"
  />

  <div class="crumbs">
    <a href="/battles">海战历史</a>
    <span aria-hidden="true">/</span>
    {op && (
      <>
        <a href={`/operations/${op.id}`}>{op.name.zh}</a>
        <span aria-hidden="true">/</span>
      </>
    )}
    <span>{b.name.zh}</span>
  </div>

  {
    op && (
      <a class="opbar" href={`/operations/${op.id}`}>
        <span class="opbar__k">本场战斗属于</span>
        <span class="opbar__t">{op.name.zh}</span>
        {op.codename && <span class="opbar__c mono">{op.codename}</span>}
        <span class="opbar__arrow" aria-hidden="true">
          ↑ 回到整场行动
        </span>
      </a>
    )
  }

  <div class="pagehead">
    <div class="pagehead__kicker">
      Battle · {b.date.from}
      {b.date.to && b.date.to !== b.date.from ? `–${b.date.to}` : ''}
    </div>
    <h1 class="pagehead__title">{b.name.zh}</h1>
    <p class="pagehead__en">{b.name.en}</p>
    <div class="pagehead__meta">
      {b.period && <span class="tag">{b.period.zh}</span>}
      {b.location && <span class="tag tag--ghost">{b.location.zh}</span>}
      <span class="tag tag--ghost">{b.timeline.length} 个事件</span>
      {b.coordinates && <span class="tag tag--ghost mono">{b.coordinates}</span>}
    </div>
  </div>

  {b.summary && <p class="lead">{b.summary.zh}</p>}

  {
    hero && hero.file && (
      <figure class="btlhero">
        <img src={hero.file} alt={hero.title.zh} loading="eager" />
        <figcaption>
          <span class="btlhero__t">{hero.title.zh}</span>
          <span class="btlhero__c">
            {imageCredit(hero)}
            <span class={`tag tag--lic-${hero.license_tier} tiny`}>{hero.license_tier} 档</span>
            {hero.source_url && (
              <a href={hero.source_url} target="_blank" rel="noopener noreferrer">
                原始页面
              </a>
            )}
          </span>
          {hero.note && <span class="btlhero__n">{hero.note}</span>}
        </figcaption>
      </figure>
    )
  }

  <!-- 参战方 -->
  <section class="section" id="sides">
    <div class="section__head">
      <h2 class="section__title">参战方</h2>
      <span class="section__en">Order of battle</span>
    </div>
    <div class="sides">
      {
        sides.map((s) => (
          <div class={`side side--${s.side}`}>
            <div class="side__head">
              <span class={`side__flag side__flag--${s.side}`} aria-hidden="true" />
              <span class="side__label">{s.label.zh}</span>
            </div>
            <div class="side__ships">
              {(s.ships ?? []).map((x) => (
                <div class="side__ship">
                  {x.ship_id ? (
                    <a class="side__name" href={`/ships/${x.ship_id}`}>
                      {x.name}
                    </a>
                  ) : (
                    <span class="side__name side__name--plain">{x.name}</span>
                  )}
                  {x.role && <span class="side__role">{x.role.zh}</span>}
                </div>
              ))}
            </div>
            {(b.forces ?? [])
              .filter((f) => f.side === s.side)
              .map((f) => (
                <p class="side__guns">{f.guns?.zh}</p>
              ))}
          </div>
        ))
      }
    </div>
    <p class="note">
      参战舰只只列实际参战的舰。同型舰未参战的不列——这样「这场战斗有哪些船」才是可查的，
      而不是靠读者自己从舰级表里排除。
    </p>
  </section>

  <!-- 事件流 -->
  <section class="section" id="timeline">
    <div class="section__head">
      <h2 class="section__title">事件流</h2>
      <span class="section__en">Minute by minute</span>
      {
        majorCount > 0 && (
          <div class="density" role="group" aria-label="事件流详略">
            <button type="button" class="density__btn is-on" data-density="major">
              概览 <span class="density__n">{majorCount}</span>
            </button>
            <button type="button" class="density__btn" data-density="all">
              逐条 <span class="density__n">{b.timeline.length}</span>
            </button>
          </div>
        )
      }
    </div>
    {majorCount === 0 && b.timeline.length > 8 && (
      <p class="section__sub">
        这场战斗的事件还没有标出关键节点，所以只能逐条看。
        标了 <code>major: true</code> 的条目会出现在「概览」里。
      </p>
    )}
    <div class="btl">
      <div class="btl__rail" aria-hidden="true">
        <span class="btl__rail-line" />
      </div>
      <ol class="btl__list">
        {
          b.timeline.map((ev) => {
            const t = tmin(ev.time);
            const pct = t !== null && first !== null ? ((t - first) / span) * 100 : 0;
            const ts = tsplit(ev.time);
            return (
              <li class:list={['btl__item', ev.major ? 'is-major' : 'is-minor']}>
                <span class="btl__dot" style={`--p:${pct.toFixed(2)}%`} aria-hidden="true" />
                <time class="btl__time mono">
                  {ts.date && <em class="btl__day">{ts.date}</em>}
                  {ts.time}
                </time>
                <div class="btl__text">
                  {ev.text.zh}
                  <span class="btl__src">{ev.src.join(' · ')}</span>
                </div>
                <ReportIssue
                  entity={b.id}
                  entityLabel={b.name.zh}
                  itemLabel={ts.time ? `事件 ${ts.time}` : '事件'}
                  current={ev.text.zh}
                  sources={ev.src}
                  kind="battle"
                />
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- 命中记录 -->
  {
    (b.hits_received ?? []).length > 0 && (
      <section class="section" id="hits">
        <div class="section__head">
          <h2 class="section__title">命中记录</h2>
          <span class="section__en">Hits received</span>
        </div>
        <p class="section__sub">
          这一战里被命中的每一发都单独记。命中数不是从「发射数 × 命中率」推出来的，
          是从射击报告和损伤记录里点出来的——所以它能和别的来源对不上，那也是数据。
        </p>
        <ol class="hits">
          {(b.hits_received ?? []).map((h, i) => (
            <li class="hit">
              <span class="hit__n mono">{String(i + 1).padStart(2, '0')}</span>
              <div class="hit__body">
                <p class="hit__text">{h.text.zh}</p>
                <span class="hit__src">{h.src.join(' · ')}</span>
              </div>
              <ReportIssue
                entity={b.id}
                entityLabel={b.name.zh}
                itemLabel={`命中记录 ${String(i + 1).padStart(2, '0')}`}
                current={h.text.zh}
                sources={h.src}
                kind="battle"
              />
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <!-- 后果 -->
  {
    (b.consequences ?? []).length > 0 && (
      <section class="section">
        <div class="section__head">
          <h2 class="section__title">战术后果</h2>
          <span class="section__en">Consequences</span>
        </div>
        <ul class="plainlist">
          {(b.consequences ?? []).map((c) => (
            <li>
              {c.text.zh}
              <span class="btl__src">{c.src.join(' · ')}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- 伤亡与结局 -->
  <section class="section" id="losses">
    <div class="section__head">
      <h2 class="section__title">伤亡与结局</h2>
      <span class="section__en">Losses & outcome</span>
    </div>
    <div class="lossgrid">
      {
        (b.losses ?? []).map((l) => (
          <div class="losscard">
            <div class="losscard__side">{l.side === 'allies' ? '英方' : l.side === 'axis' ? '德方' : l.side}</div>
            {l.ships_lost && <div class="losscard__ship">{l.ships_lost.zh}</div>}
            <div class="losscard__nums">
              {typeof l.killed === 'number' && (
                <span>
                  <strong>{l.killed.toLocaleString('en-US')}</strong> 阵亡
                </span>
              )}
              {typeof l.survivors === 'number' && (
                <span>
                  <strong>{l.survivors}</strong> 生还
                </span>
              )}
            </div>
            {l.note && <p class="losscard__note">{l.note.zh}</p>}
            <ReportIssue
              entity={b.id}
              entityLabel={b.name.zh}
              itemLabel={`伤亡与结局 · ${l.side === 'allies' ? '英方' : l.side === 'axis' ? '德方' : l.side}`}
              current={[
                l.ships_lost?.zh,
                typeof l.killed === 'number' ? `阵亡 ${l.killed.toLocaleString('en-US')}` : '',
                typeof l.survivors === 'number' ? `生还 ${l.survivors}` : '',
              ]
                .filter(Boolean)
                .join('；')}
              kind="battle"
            />
          </div>
        ))
      }
    </div>
    {b.outcome && (
      <div class="callout">
        <div class="callout__title">结局怎么评</div>
        <p>{b.outcome.zh}</p>
      </div>
    )}
  </section>

  <!-- 图集 -->
  {
    gallery.length > 0 && (
      <section class="section" id="gallery">
        <div class="section__head">
          <h2 class="section__title">影像</h2>
          <span class="section__en">{gallery.length} 张</span>
        </div>
        <div class="btlgallery">
          {gallery.map((g) => (
            <figure class="btlgallery__item">
              <img src={g.file} alt={g.title.zh} loading="lazy" />
              <figcaption>
                <span class="btlgallery__t">{g.title.zh}</span>
                <span class="btlgallery__c">
                  {imageCredit(g)}
                  <span class={`tag tag--lic-${g.license_tier} tiny`}>{g.license_tier} 档</span>
                </span>
                {g.note && <span class="btlgallery__n">{g.note}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- 同一行动里的其他战斗 -->
  {
    siblings.length > 0 && op && (
      <section class="section" id="siblings">
        <div class="section__head">
          <h2 class="section__title">同一行动里的其他战斗</h2>
          <span class="section__en">Elsewhere in {op.codename ?? op.name.en}</span>
        </div>
        <div class="siblist">
          {siblings.map((s) => (
            <a class="sibrow" href={`/battles/${s.battle.id}`}>
              <span class="sibrow__date mono">
                {String(s.phase.date.from).slice(5).replace('-', '.')}
              </span>
              <span class="sibrow__body">
                <span class="sibrow__t">{s.battle.name.zh}</span>
                <span class="sibrow__en">{s.battle.name.en}</span>
              </span>
              <span class="sibrow__n mono">{s.battle.timeline.length} 事件</span>
              <span class="sibrow__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- 来源 -->
  <section class="section" id="sources">
    <div class="section__head">
      <h2 class="section__title">本页来源</h2>
      <span class="section__en">Sources</span>
    </div>
    <ul class="plainlist plainlist--tight">
      {
        usedSources.map((s) => (
          <li>
            <span class={`conf conf--${s!.tier}`}>{s!.tier}</span>{' '}
            <a href={s!.url} target="_blank" rel="noopener noreferrer">
              {s!.title}
            </a>
            <span class="mono tiny muted"> {s!.id}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    majorCount > 0 && (
      <script>
        // 事件流详略切换。默认「概览」——读者先要骨架，需要细节再展开。
        // 纯前端，无需重渲染：靠父容器上的 data-density 属性控制 CSS 显隐。
        (function () {
          const wrap = document.querySelector('.btl');
          const btns = document.querySelectorAll('.density__btn');
          if (!wrap || !btns.length) return;
          function apply(mode) {
            wrap.dataset.density = mode;
            btns.forEach((b) => {
              const on = b.dataset.density === mode;
              b.classList.toggle('is-on', on);
              b.setAttribute('aria-pressed', String(on));
            });
            try {
              localStorage.setItem('dockyard-btl-density', mode);
            } catch (e) {
              /* 隐私模式禁用存储，忽略即可 */
            }
          }
          btns.forEach((b) => {
            b.addEventListener('click', () => apply(b.dataset.density));
          });
          // 记住上次选择，跨战斗页生效——读者偏好是稳定的。
          let saved = null;
          try {
            saved = localStorage.getItem('dockyard-btl-density');
          } catch (e) {}
          apply(saved === 'all' ? 'all' : 'major');
        })();
      </script>
    )
  }
</Base>

<style>
  /* ---------------------------------------------------- 事件流详略切换 */
  .density {
    margin-left: auto;
    display: inline-flex;
    border: 1px solid var(--line-300);
    border-radius: 7px;
    overflow: hidden;
  }
  .density__btn {
    font: inherit;
    font-size: 11.5px;
    padding: 5px 11px;
    border: 0;
    background: #fff;
    color: var(--ink-600);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .density__btn + .density__btn {
    border-left: 1px solid var(--line-300);
  }
  .density__btn:hover {
    background: var(--paper-100, #f5f7fa);
  }
  .density__btn.is-on {
    background: var(--navy-800);
    color: #fff;
  }
  .density__n {
    opacity: 0.65;
    font-size: 10px;
    margin-left: 3px;
    font-variant-numeric: tabular-nums;
  }

  /* 概览模式：藏掉次要条目，并把保留条目的左竖线加重，
     让「骨架」在视觉上站得住，而不是变成稀疏的空列表。 */
  .btl[data-density='major'] .btl__item.is-minor {
    display: none;
  }
  .btl[data-density='major'] .btl__item.is-major .btl__dot {
    box-shadow: 0 0 0 3px rgba(37, 99, 168, 0.16);
  }
  .btl[data-density='major'] .btl__item.is-major .btl__text {
    font-weight: 500;
  }

  .pagehead__en {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--ink-300);
    letter-spacing: 0.02em;
  }

  /* 上级行动条：战斗页顶部给一条回上游的路。
     放在 crumbs 之后、标题之前——读者先知道自己站在哪一段历史里，再看这场仗本身。 */
  .opbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 9px 15px;
    margin-bottom: 14px;
    border: 1px solid var(--blue-200);
    border-left: 3px solid var(--blue-500);
    border-radius: 3px;
    background: var(--blue-50);
    text-decoration: none;
    color: inherit;
    transition: background 0.16s ease, border-color 0.16s ease;
  }
  .opbar:hover {
    background: var(--blue-100);
    border-color: var(--blue-400);
  }
  .opbar__k {
    font-size: 10.5px;
    color: var(--ink-400);
    letter-spacing: 0.04em;
  }
  .opbar__t {
    font-size: 13.5px;
    font-weight: 680;
    color: var(--blue-700);
  }
  .opbar__c {
    font-size: 10.5px;
    color: var(--ink-400);
  }
  .opbar__arrow {
    margin-left: auto;
    font-size: 11.5px;
    color: var(--blue-600);
    white-space: nowrap;
  }

  /* 同行动的其他战斗 */
  .siblist {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sibrow {
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr) auto 18px;
    gap: 14px;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--white);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.16s ease, background 0.16s ease;
  }
  .sibrow:hover {
    border-color: var(--blue-300);
    background: var(--blue-50);
  }
  .sibrow__date {
    font-size: 12px;
    color: var(--blue-700);
  }
  .sibrow__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .sibrow__t {
    font-size: 14px;
    font-weight: 620;
    color: var(--ink-900);
  }
  .sibrow__en {
    font-size: 11px;
    color: var(--ink-300);
