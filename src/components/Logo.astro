---
// ============================================================================
// Dockyard 字标（横排艺术字，不是方框图标）
// ----------------------------------------------------------------------------
// 2026-11-22 第三版（定稿）。
//
// 构成（两层）：
//   ① 左侧一枚罗经星（细线，红蓝双色针）—— 唯一的图形元素，代表「定位」
//   ② DOCKYARD 全大写，粗黑，字距 2.6，整体斜切 -8°
//
// 试过但被否掉的方向，留档免得下次重做：
//   · 方框图标（正方形）：用户明确否掉，「不要正方形的，要一排艺术字」。
//     方形 D 还试过 5 版：细锚 / 舰艏正视梯形 / 三道横带 + 粗锚 /
//     舰艏侧影 / 战舰俯视 —— 16–32px 下全部糊成色块或笑脸。
//   · W1「横带切字」：字被水线切成上下两半，小尺寸比例失真。
//   · W3「字内嵌水线渐变」：好看，但深色背景中段黑字消失。
//   · W4「纯斜体 + 三条速度线」：速度感最好，但深色背景黑字消失。
//   · 速度线（红/灰/蓝三根）：在 30px 高度下只有 2.6px 粗，
//     红蓝两根几乎看不见，剩一根灰的像误留的下划线 —— 用户选了去掉。
//
// 保留下来的：罗经星 + 斜切字（取 W2 的图形 + W4 的斜切）。
// 字与罗经用 currentColor，红蓝针保持固有色 —— 那两个颜色是「船」的
// 一部分，不该跟着主题走。
//
// 尺寸：height 为渲染高度，宽按 262:44 自适应。
// ============================================================================
interface Props {
  /** 字标高度（px）。宽高比约 5.6:1 */
  height?: number;
  class?: string;
}

const { height = 34, class: klass = '' } = Astro.props;
// 2026-11-22 第三次改：用户选了「去掉速度线」。
// 去掉后 viewBox 可以收紧 —— 原来留 50 的高度是为了容纳 y=43 的三条线，
// 现在字基线在 33，字高约 27，上留 6 下留 6 就够，H 收到 44。
// 宽度也跟着收：原来 276 是给速度线（到 x=253）留的，
// 现在字到 x≈252 结束（斜切后右移），留一点余量取 262。
const W = 262;
const H = 44;
const width = Math.round((height * W) / H);
---

<span
  class:list={['wm', klass]}
  role="img"
  aria-label="Dockyard 船坞"
  style={`--wm-h:${height}px`}
>
  <svg
    width={width}
    height={height}
    viewBox={`0 0 ${W} ${H}`}
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="wmR" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#e0414b"></stop>
        <stop offset="1" stop-color="#a81c26"></stop>
      </linearGradient>
      <linearGradient id="wmB" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#7cc0e8"></stop>
        <stop offset="1" stop-color="#2a72a8"></stop>
      </linearGradient>
    </defs>

    <!-- ① 罗经星：外环 + 内环 + 四向针 -->
    <g transform="translate(20 24)" fill="none">
      <circle r="14.5" stroke="currentColor" stroke-width="1.7" opacity="0.82"></circle>
      <circle r="7.4" stroke="#3f93c9" stroke-width="1.15" opacity="0.9"></circle>
      <!-- 南北针（红） -->
      <path d="M0 -14.5 L2.9 0 L0 14.5 L-2.9 0 Z" fill="#c8262f" opacity="0.95"></path>
      <!-- 东西针（蓝） -->
      <path d="M-14.5 0 L0 -2.9 L14.5 0 L0 2.9 Z" fill="#3f93c9" opacity="0.95"></path>
      <circle r="2" fill="currentColor"></circle>
    </g>

    <!-- ② 字：斜切 -8°，速度感 -->
    <g transform="skewX(-8) translate(6 0)">
      <text
        x="46"
        y="33"
        font-family="Inter, 'Helvetica Neue', Arial, 'Noto Sans SC', sans-serif"
        font-size="27"
        font-weight="900"
        letter-spacing="2.6"
        fill="currentColor">DOCKYARD</text>
    </g>
  </svg>
</span>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    color: var(--ink-900);
    line-height: 0;
  }
  .wm svg {
    display: block;
    height: var(--wm-h);
    width: auto;
    /* 速度线末端是 round 的，overflow 必须可见，否则外圈被裁 */
    overflow: visible;
  }
  /* 深色背景下调用方给 color: #fff 即可，字与罗经跟着变白，
     只有红/蓝两根针与速度线保持固有色 —— 这是刻意的：
     那两个颜色是「船」的一部分，不该跟着主题走。 */
</style>
