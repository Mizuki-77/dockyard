---
// ============================================================================
// 目录树 —— 「海战历史」「武器与装备」两个栏目共用的左侧层级索引。
// ----------------------------------------------------------------------------
// 两个栏目的树深度不同：
//   海战历史   海区 → 年份 → 战斗        （两层分组）
//   武器与装备 类别 → 国别 → 型号        （两层分组，但中间层要能折叠）
//
// 所以这里不写死层数，而是「分支（branch）→ 可选子组（group）→ 叶子（leaf）」：
// 没有 groups 的分支直接把 leaves 铺开，有 groups 的展开成第二级 <details>。
// 两个栏目共用同一份渲染，免得改一处忘另一处。
//
// 为什么用 <details> 而不是 JS 折叠：
//   静态站不该为了展开/收起加载一段脚本；<details> 天生可键盘操作、
//   搜索框按 Ctrl+F 也能找到被折叠的项（现代浏览器会展开命中的 details）。
// ============================================================================
export interface TreeLeaf {
  label: string;
  en?: string;
  href: string;
  count?: number;
  hint?: string;
  meta?: string;
  /**
   * 可选：点击时要交给客户端的标识。
   * 对比器左侧索引用它把「点树上的舰」映射到「勾选上方那艘舰」，
   * 而不是跳去 /ships/<id> 把正在对比的组合丢掉。
   */
  dataShip?: string;
}

/** 中间层：branch 内部的第二级分组（武器树用国别，海战树不用）。 */
export interface TreeGroup {
  key: string;
  label: string;
  en?: string;
  count?: number;
  leaves: TreeLeaf[];
}

export interface TreeBranch {
  key: string;
  label: string;
  en?: string;
  count?: number;
  hint?: string;
  /** 不给就是两层树，给了就是三层树 */
  groups?: TreeGroup[];
  /** 两层树时用这个；给了 groups 就忽略 */
  leaves?: TreeLeaf[];
}

interface Props {
  kicker: string;
  title: string;
  branches: TreeBranch[];
  /** 当前页面对应的叶子 href，用来高亮 */
  currentHref?: string;
  note?: string;
  /** 树底部的一条额外链接（如「全部 / 按年份」） */
  footLink?: { href: string; label: string };
  /**
   * 首层分支是否默认展开。
   *   true  = 列表页（树就是内容，全展开）
   *   false = 默认全折叠，只露类名（2026-11-25 用户要求「武器与装备左侧列表默认折叠」）
   *
   * 无论哪种，含当前页的那一支**始终展开** —— 否则从详情页进来
   * 会看不到自己在树里的位置，那比折叠更糟。
   */
  defaultOpen?: boolean;
}

const {
  kicker, title, branches, currentHref, note, footLink,
  defaultOpen = true,
} = Astro.props;

/** 某分支下的全部叶子，两层三层都能取到。 */
function leavesOf(b: TreeBranch): TreeLeaf[] {
  if (b.groups && b.groups.length > 0) return b.groups.flatMap((g) => g.leaves);
  return b.leaves ?? [];
}

const total = branches.reduce((n, b) => n + leavesOf(b).length, 0);

// 折叠策略：
//   当前 href 不在任何一支里（比如路径写错）→ 按 defaultOpen 来，
//     不要因为「没找到」就把所有分支强行展开（那是上一版的行为，会让折叠失效）。
//   含当前项的支 → 一定展开。
//   其余支 → 看 defaultOpen。
const anyCurrent = branches.some((b) => leavesOf(b).some((l) => l.href === currentHref));

function branchOpen(b: TreeBranch): boolean {
  // 含当前项的那一支永远展开——否则从详情页进来找不到自己在哪
  if (leavesOf(b).some((l) => l.href === currentHref)) return true;
  // 当前页不在任何一支里（列表页）：听 defaultOpen
  if (!anyCurrent) return defaultOpen;
  // 详情页的其他支：收起
  return false;
}

function groupOpen(g: TreeGroup): boolean {
  if (g.leaves.some((l) => l.href === currentHref)) return true;
  if (!anyCurrent) return defaultOpen;
  return false;
}
---

<aside class="ctree" aria-label={title}>
  <div class="ctree__head">
    <div class="ctree__kicker">{kicker}</div>
    <div class="ctree__title">{title}</div>
    <div class="ctree__count">
      {branches.length} 类 · {total} 项
    </div>
  </div>

  {
    branches.length === 0 ? (
      <div class="ctree__empty">暂无条目</div>
    ) : (
      branches.map((b) => {
        const hasGroups = Boolean(b.groups && b.groups.length > 0);
        return (
          <details class="ctree__branch" open={branchOpen(b)}>
            <summary class="ctree__sum">
              <span class="ctree__bullet" aria-hidden="true" />
              <span class="ctree__blabel">{b.label}</span>
              {b.en && <span class="ctree__ben">{b.en}</span>}
              <span class="ctree__bcount">{b.count ?? leavesOf(b).length}</span>
            </summary>
            {b.hint && <p class="ctree__bhint">{b.hint}</p>}

            {hasGroups ? (
              b.groups!.map((g) => (
                <details class="ctree__group" open={groupOpen(g)}>
                  <summary class="ctree__gsum">
                    <span class="ctree__gbullet" aria-hidden="true" />
                    <span class="ctree__glabel">{g.label}</span>
                    {g.en && <span class="ctree__gen">{g.en}</span>}
                    <span class="ctree__gcount">{g.count ?? g.leaves.length}</span>
                  </summary>
                  <ul class="ctree__leaves ctree__leaves--deep">
                    {g.leaves.map((l) => (
                      <li>
                        <a
                          class:list={['ctree__leaf', l.href === currentHref && 'ctree__leaf--on']}
                          href={l.href}
                          aria-current={l.href === currentHref ? 'page' : undefined}
                          title={l.meta || undefined}
                          data-ship={l.dataShip}
                        >
                          <span class="ctree__llabel">{l.label}</span>
                          {l.meta && <span class="ctree__lmeta">{l.meta}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))
            ) : (
              <ul class="ctree__leaves">
                {(b.leaves ?? []).map((l) => (
                  <li>
                    <a
                      class:list={['ctree__leaf', l.href === currentHref && 'ctree__leaf--on']}
                      href={l.href}
                      aria-current={l.href === currentHref ? 'page' : undefined}
                      title={l.meta || undefined}
                      data-ship={l.dataShip}
                    >
                      <span class="ctree__llabel">{l.label}</span>
                      {l.meta && <span class="ctree__lmeta">{l.meta}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </details>
        );
      })
    )
  }

  {footLink && <a class="ctree__foot" href={footLink.href}>{footLink.label}</a>}
  {note && <div class="ctree__note">{note}</div>}
</aside>

<style>
  .ctree {
    position: sticky;
    top: calc(var(--nav-h) + 16px);
    max-height: calc(100vh - var(--nav-h) - 32px);
    overflow-y: auto;
    padding: 0 4px 8px 0;
    font-size: 12.5px;
  }
  .ctree__head {
    padding: 0 0 12px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 6px;
  }
  .ctree__kicker {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blue-500);
  }
  .ctree__title {
    margin-top: 3px;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: -0.01em;
  }
  .ctree__count {
    margin-top: 2px;
    font-size: 10.5px;
    color: var(--ink-300);
    font-family: var(--font-mono);
  }
  .ctree__empty {
    padding: 14px 0;
    font-size: 12px;
    color: var(--ink-400);
  }

  /* ---------------- 第一级：类别 / 海区 ---------------- */
  .ctree__branch {
    border-bottom: 1px solid var(--line-soft, var(--line));
  }
  .ctree__sum {
    display: flex;
    align-items: baseline;
    gap: 7px;
    padding: 9px 2px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .ctree__sum::-webkit-details-marker {
    display: none;
  }
  .ctree__bullet {
    width: 5px;
    height: 5px;
    flex: none;
    border-radius: 50%;
    background: var(--blue-400);
    transform: translateY(-2px);
    transition: background 0.15s ease;
  }
  .ctree__branch[open] > .ctree__sum .ctree__bullet {
    background: var(--blue-600);
  }
  .ctree__blabel {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--ink-800);
  }
  .ctree__sum:hover .ctree__blabel {
    color: var(--blue-700);
  }
  .ctree__ben {
    font-size: 10px;
    color: var(--ink-300);
    letter-spacing: 0.03em;
  }
  .ctree__bcount {
    margin-left: auto;
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--ink-300);
  }
  .ctree__bhint {
    margin: 0 0 6px 12px;
    font-size: 10.5px;
    line-height: 1.6;
    color: var(--ink-400);
  }

  /* ---------------- 第二级：国别 ---------------- */
  .ctree__group {
    border-left: 1px solid var(--line);
    margin: 0 0 2px 6px;
  }
  .ctree__gsum {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 2px 5px 10px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .ctree__gsum::-webkit-details-marker {
    display: none;
  }
  .ctree__gbullet {
    width: 4px;
    height: 4px;
    flex: none;
    border-radius: 50%;
    background: var(--line-strong, var(--ink-300));
    transform: translateY(-1px);
    transition: background 0.15s ease;
  }
  .ctree__group[open] > .ctree__gsum .ctree__gbullet {
    background: var(--blue-500);
  }
  .ctree__glabel {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-600);
  }
  .ctree__gsum:hover .ctree__glabel {
    color: var(--blue-700);
  }
  .ctree__gen {
    font-size: 9.5px;
    color: var(--ink-300);
    letter-spacing: 0.02em;
  }
  .ctree__gcount {
    margin-left: auto;
    font-size: 9.5px;
    font-family: var(--font-mono);
    color: var(--ink-300);
  }

  /* ---------------- 第三级 / 叶子 ---------------- */
  .ctree__leaves {
    list-style: none;
    margin: 0 0 8px;
    padding: 0 0 0 12px;
  }
  /* 三层树的叶子再缩进一档，让「型号」明显从属于「国别」 */
  .ctree__leaves--deep {
    padding-left: 22px;
    margin: 0 0 6px;
  }
  .ctree__leaf {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 5px 8px 5px 10px;
    border-left: 2px solid transparent;
    border-radius: 0 3px 3px 0;
    text-decoration: none;
    color: var(--ink-600);
    line-height: 1.45;
    transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease;
  }
  .ctree__leaf:hover {
    background: var(--blue-50);
    color: var(--blue-700);
    border-left-color: var(--blue-300);
  }
  .ctree__leaf--on {
    background: var(--blue-50);
    border-left-color: var(--blue-600);
    color: var(--blue-800, var(--blue-700));
    font-weight: 620;
  }
  .ctree__llabel {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .ctree__lmeta {
    flex: none;
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--ink-300);
  }

  .ctree__foot {
    display: block;
    margin-top: 10px;
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-size: 11.5px;
    text-align: center;
    text-decoration: none;
    color: var(--ink-500);
    background: var(--white);
  }
  .ctree__foot:hover {
    border-color: var(--blue-300);
    color: var(--blue-700);
    background: var(--blue-50);
  }
  .ctree__note {
    margin-top: 10px;
    padding-top: 9px;
    border-top: 1px dashed var(--line);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--ink-400);
  }

  @media (max-width: 1080px) {
    .ctree {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }
</style>
